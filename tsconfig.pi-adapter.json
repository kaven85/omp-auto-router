{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": false,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["bun"]
	},
	"include": ["src/core/**/*.ts", "src/pi-adapter/**/*.ts", "tests/pi-adapter/**/*.ts"]
}
