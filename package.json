{
	"name": "omp-auto-router",
	"version": "0.5.0",
	"description": "Profile-based, complexity-aware auto router extension for Oh My Pi (omp)",
	"type": "module",
	"private": true,
	"omp": {
		"extensions": ["./src/omp-adapter/index.ts"]
	},
	"scripts": {
		"test": "bun test tests/",
		"test:adapter": "bun test tests/omp-adapter/",
