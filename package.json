		"check:adapter": "bunx tsc -p tsconfig.adapter.json --noEmit"
	},
	"dependencies": {
		"yaml": "^2.5.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.84.1",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@types/bun": "^1.3.14",
		"typescript": "^5.9.3"
	}
}
